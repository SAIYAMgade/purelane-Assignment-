<section class="hero" id="hero-{{ section.id }}">
  <div class="hero__grid">
    <aside class="hero__badges" role="list" aria-label="Product promises">
      {% for block in section.blocks %}
        {% if block.type == 'badge' %}
          <div class="hero__badge" role="listitem" {{ block.shopify_attributes }}>
            <span class="hero__badge-icon" aria-hidden="true">
              {% case forloop.index0 %}
                {% when 0 %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {% when 1 %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
              {% endcase %}
            </span>
            <span>{{ block.settings.label | newline_to_br }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </aside>

    <div class="hero__copy">
      <h1 class="hero__heading">
        {% assign headline_parts = section.settings.headline | split: '|' %}
        {% if headline_parts.size > 1 %}
          {{ headline_parts[0] | strip }} <span class="hero__heading-accent">{{ headline_parts[1] | strip }}</span>
        {% else %}
          {{ section.settings.headline }}
        {% endif %}
      </h1>

      <div class="hero__rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>

      <div class="hero__description">
        {{ section.settings.description }}
      </div>

      <div class="hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="hero__button hero__button--primary" href="{{ section.settings.primary_link | default: '#' }}">
            {{ section.settings.primary_label }}
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="hero__button hero__button--secondary" href="{{ section.settings.secondary_link | default: '#' }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>

      <div class="hero__badge-strip" role="list" aria-label="Product promises">
        {% for block in section.blocks %}
          {% if block.type == 'badge' %}
            <div role="listitem" {{ block.shopify_attributes }}>
              <span aria-hidden="true">
                {% case forloop.index0 %}
                  {% when 0 %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                  {% when 1 %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                  {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {% endcase %}
              </span>
              {{ block.settings.label }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% assign pricing_tier_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'pricing_tier' %}
        {% assign pricing_tier_count = pricing_tier_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if pricing_tier_count > 0 %}
      <div class="hero__product" data-hero-product>
        <div class="hero__stage" data-hero-stage aria-live="polite">
          {% assign pricing_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'pricing_tier' %}
              {% assign stage_variant = pricing_index | modulo: 3 %}
              <div class="hero__slide hero__slide--{{ stage_variant | plus: 1 }}{% if pricing_index == 0 %} is-active{% endif %}" data-hero-slide data-index="{{ pricing_index }}" aria-hidden="{% if pricing_index == 0 %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
                {% if stage_variant == 0 %}
                  <span class="hero__product-art hero__product-art--kbtl hero__product-a" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
                {% elsif stage_variant == 1 %}
                  <span class="hero__product-art hero__product-art--tbtl hero__product-a" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
                  <span class="hero__product-art hero__product-art--kbtl hero__product-b" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
                {% else %}
                  <span class="hero__product-art hero__product-art--tbtl hero__product-a" role="img" aria-label="Purelane tap cleaner and limescale remover spray bottle"></span>
                  <span class="hero__product-art hero__product-art--mbtl hero__product-b" role="img" aria-label="Purelane copper, bronze and brass cleaner pump bottle"></span>
                  <span class="hero__product-art hero__product-art--kbtl hero__product-c" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
                {% endif %}

                <div class="hero__price-tag">
                  {% if block.settings.tier_label != blank %}<span class="hero__price-label">{{ block.settings.tier_label }}</span>{% endif %}
                  <span class="hero__price-value">
                    {% if block.settings.price != blank %}<strong>{{ block.settings.price }}</strong>{% endif %}
                    {% if block.settings.compare_at_price != blank %}<s>{{ block.settings.compare_at_price }}</s>{% endif %}
                  </span>
                  {% if block.settings.savings_label != blank %}<span class="hero__price-saving">{{ block.settings.savings_label }}</span>{% endif %}
                </div>
              </div>
              {% assign pricing_index = pricing_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>

        {% if pricing_tier_count > 1 %}
          <div class="hero__dots" data-hero-dots role="tablist" aria-label="Hero offers">
            {% assign pricing_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'pricing_tier' %}
                <button type="button" role="tab" aria-selected="{% if pricing_index == 0 %}true{% else %}false{% endif %}" aria-label="Show offer {{ pricing_index | plus: 1 }}" data-hero-dot data-index="{{ pricing_index }}" class="{% if pricing_index == 0 %}is-active{% endif %}"></button>
                {% assign pricing_index = pricing_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #hero-{{ section.id }} {
    --ink: #f4f0fb;
    --deep: #e2daf3;
    --brand: #4b3a8f;
    --brand-lt: #6b55b8;
    --paper: #241a3d;
    --paper-2: rgba(36, 26, 61, .78);
    --paper-3: rgba(36, 26, 61, .56);
    --accent: #b8701c;
    --accent-2: #c9761d;
    --surface: #17102b;
    --r: 26px;
    --r-sm: 16px;
    --sec-y: 34px;
    --ease: cubic-bezier(.2, .7, .2, 1);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    gap: 2rem;
    align-items: center;
    padding: var(--sec-y) 5vw;
  }

  #hero-{{ section.id }} .hero__badges,
  #hero-{{ section.id }} .hero__actions,
  #hero-{{ section.id }} .hero__pricing {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #hero-{{ section.id }} .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
  }

  #hero-{{ section.id }} .hero__heading {
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 0.95;
    margin: 1.5rem 0;
    color: var(--surface);
  }

  #hero-{{ section.id }} .hero__heading-accent {
    color: var(--accent);
  }

  #hero-{{ section.id }} .hero__description {
    max-width: 38rem;
    margin-bottom: 1.5rem;
    color: var(--paper-2);
  }

  #hero-{{ section.id }} .hero__button {
    display: inline-block;
    padding: 0.8rem 1.25rem;
    text-decoration: none;
    border-radius: 999px;
  }

  #hero-{{ section.id }} .hero__button--primary {
    background: linear-gradient(135deg, #00706a, #004b46);
    color: #f4fdf6;
    border: 0;
  }

  #hero-{{ section.id }} .hero__button--secondary {
    background: rgba(255, 255, 255, .66);
    border: 1px solid rgba(75, 58, 143, .22);
    color: #01423b;
  }

  #hero-{{ section.id }} .hero__pricing-tier {
    min-width: 8rem;
    border-radius: var(--r-sm);
  }

  #hero-{{ section.id }} .hero__pricing-label,
  #hero-{{ section.id }} .hero__pricing-price,
  #hero-{{ section.id }} .hero__pricing-compare,
  #hero-{{ section.id }} .hero__pricing-savings {
    margin: 0.25rem 0;
  }

  @media screen and (max-width: 749px) {
    #hero-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }
</style>

